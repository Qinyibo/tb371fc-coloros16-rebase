; Dedicated native scheduler domain. No Magisk context or policy dependency.
(type tb371fc_scheduler)
(typeattributeset domain (tb371fc_scheduler))
(typeattributeset coredomain (tb371fc_scheduler))
(typeattributeset mlstrustedsubject (tb371fc_scheduler))
(roletype r tb371fc_scheduler)
(type tb371fc_scheduler_exec)
(typeattributeset file_type (tb371fc_scheduler_exec))
(typeattributeset exec_type (tb371fc_scheduler_exec))
(typeattributeset system_file_type (tb371fc_scheduler_exec))
(type tb371fc_scheduler_data_file)
(typeattributeset file_type (tb371fc_scheduler_data_file))
(typeattributeset data_file_type (tb371fc_scheduler_data_file))
(typeattributeset core_data_file_type (tb371fc_scheduler_data_file))

(typetransition init tb371fc_scheduler_exec process tb371fc_scheduler)
(allow init tb371fc_scheduler (process (transition siginh rlimitinh)))
(allow tb371fc_scheduler init (process (sigchld)))
(allow init tb371fc_scheduler_exec (file (getattr open read execute map)))
(allow tb371fc_scheduler tb371fc_scheduler_exec (file (entrypoint getattr open read execute map)))
(allow tb371fc_scheduler init (fd (use)))
(allow tb371fc_scheduler null_device (chr_file (getattr open read write ioctl)))
(allow tb371fc_scheduler system_file (dir (getattr search open read)))
(allow tb371fc_scheduler system_file (file (getattr open read map execute)))
(allow tb371fc_scheduler system_file (lnk_file (getattr read)))
(allow tb371fc_scheduler system_lib_file (file (getattr open read map execute)))
(allow tb371fc_scheduler system_linker_exec (file (getattr open read map execute)))
(allow tb371fc_scheduler system_linker_exec (lnk_file (getattr read)))
(allow tb371fc_scheduler apex_mnt_dir (dir (getattr search open read)))
(allow tb371fc_scheduler linkerconfig_file (dir (getattr search open read)))
(allow tb371fc_scheduler linkerconfig_file (file (getattr open read map)))
(allow tb371fc_scheduler rootfs (dir (getattr search)))
(allow tb371fc_scheduler device (dir (getattr search)))

; Proc identities and actual kernel foreground memberships are always checked.
(allow tb371fc_scheduler proc (dir (getattr search open read)))
(allow tb371fc_scheduler proc (lnk_file (getattr read)))
(allow tb371fc_scheduler proc_cgroups (file (getattr open read)))
(allow tb371fc_scheduler domain (dir (getattr search open read)))
(allow tb371fc_scheduler domain (file (getattr open read)))
(allow tb371fc_scheduler domain (process (getattr)))
; Use the real framework power service, without reading generic hardware sysfs.
(allow tb371fc_scheduler binder_device (chr_file (getattr open read write ioctl map)))
(allow tb371fc_scheduler servicemanager (binder (call transfer)))
(allow servicemanager tb371fc_scheduler (binder (transfer)))
(allow tb371fc_scheduler power_service (service_manager (find)))
(allow tb371fc_scheduler system_server (binder (call transfer)))
(allow system_server tb371fc_scheduler (binder (transfer)))
(allow tb371fc_scheduler system_data_root_file (dir (getattr search)))
(allow tb371fc_scheduler system_data_file (dir (getattr search)))
(allow tb371fc_scheduler packages_list_file (file (getattr open read)))
(allow tb371fc_scheduler tb371fc_scheduler_data_file (dir (getattr search open read write add_name)))
(allow tb371fc_scheduler tb371fc_scheduler_data_file (file (create getattr open read write lock)))
(typetransition tb371fc_scheduler tb371fc_scheduler_data_file file tb371fc_scheduler_data_file)
(allow tb371fc_scheduler cgroup (dir (getattr search open read)))
(allow tb371fc_scheduler cgroup (file (getattr open read write)))
(allow tb371fc_scheduler cgroup (filesystem (getattr)))

; The service cannot mount controllers, change priorities, ptrace, or tune sysfs.
(neverallow tb371fc_scheduler self (capability (sys_admin sys_nice sys_ptrace)))
(neverallow tb371fc_scheduler sysfs_type (file (write append create unlink rename setattr)))
