buffers { size_kb: 131072 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
duration_ms: 63000
unique_session_name: "four-app-cold-aba-115221"
data_sources { config { name: "linux.ftrace" target_buffer: 0 ftrace_config {
 ftrace_events: "sched/sched_switch"
 ftrace_events: "sched/sched_waking"
 ftrace_events: "power/cpu_frequency"
 ftrace_events: "power/cpu_idle"
 ftrace_events: "binder/binder_transaction"
 ftrace_events: "binder/binder_transaction_received"
 ftrace_events: "sched/sched_process_exit"
 ftrace_events: "task/task_newtask"
 ftrace_events: "task/task_rename"
 atrace_categories: "gfx"

 atrace_categories: "wm"
 atrace_categories: "am"
 atrace_apps: "com.android.launcher"
 atrace_apps: "com.android.systemui"
 atrace_apps: "com.ss.android.ugc.aweme"
 atrace_apps: "com.tencent.mm"
 atrace_apps: "com.tencent.mobileqq"
 atrace_apps: "com.luna.music"
} } }
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 1 } }
data_sources { config { name: "linux.process_stats" target_buffer: 1 process_stats_config { scan_all_processes_on_start: true } } }
data_sources { config { name: "linux.sys_stats" target_buffer: 1 sys_stats_config {
 meminfo_period_ms: 500
 meminfo_counters: MEMINFO_MEM_AVAILABLE
 stat_period_ms: 500
 stat_counters: STAT_CPU_TIMES
} } }
